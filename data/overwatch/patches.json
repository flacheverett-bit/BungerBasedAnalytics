{
  "game": "overwatch",
  "updated": "2026-11-24T07:54:38Z",
  "latest": {
    "version": "Season 5 mid-season update (Taking Reign)",
    "date": "2026-11-03",
    "title": "Taking Reign mid-season balance update",
    "url": "https://overwatch.blizzard.com/en-us/news/patch-notes/live/2026/11",
    "summary": "The Season 5 mid-season update reins in Doctrine, Sombra, D.Mon, Genji and Vendetta. It buffs brawl tanks and sustain supports such as Junker Queen, Mauga, Brigitte and Illari. A November 5 hotfix then made Wrecking Ball's Grappling Claw retract faster.",
    "meta_impact": "Close-range brawl got stronger. Junker Queen jumped to the top tank win rate, and Reaper and Brigitte rose with her. Dive lost some power through Genji's shorter Deflect and Winston's weaker healing perk.\n\nOn support, the high-output Doctrine and Sombra lost power, and Ana's grenade does less damage. Zenyatta, Brigitte and Illari now lead the support win rates. D.Mon fell from a strong pick to one of the weakest tanks.",
    "changes": [
      {
        "character": "D.Mon",
        "type": "nerf",
        "details": [
          "Overstrike (Major Perk): lifesteal 150% -> 125%",
          "Power Barrier: recovery 0.2s -> 0.3s, new 0.25s minimum deploy duration",
          "Propulsors: impact damage 15 -> 0 (knockback kept)"
        ],
        "playstyle_impact": "Commit to barrier placements deliberately and rely less on Propulsors for burst damage.",
        "meta_impact": "Drops from a strong pick to one of the lowest win-rate tanks."
      },
      {
        "character": "Junker Queen",
        "type": "buff",
        "details": [
          "Base health 375 -> 425 (6v6: 450 -> 500)",
          "Carnage cooldown 9s -> 7s",
          "Commanding Shout: new UI showing allies in range and affected"
        ],
        "playstyle_impact": "Brawl longer even without wounds applied, and use Carnage more often to keep pressure up.",
        "meta_impact": "Now the highest win-rate tank and the core of rush comps."
      },
      {
        "character": "Mauga",
        "type": "buff",
        "details": [
          "Base armor 125 -> 150",
          "Incendiary Chaingun burn damage over time 15 -> 20"
        ],
        "playstyle_impact": "Lean on ignites and frontline more confidently with the extra armor.",
        "meta_impact": "Climbs back into viability, especially in higher ranks."
      },
      {
        "character": "Ramattra",
        "type": "buff",
        "details": [
          "Void Accelerator ammo 100 -> 125"
        ],
        "playstyle_impact": "Poke longer in Omnic form before needing to reload or enter Nemesis Form.",
        "meta_impact": "Small buff that does not lift him out of the lower tank tier."
      },
      {
        "character": "Winston",
        "type": "nerf",
        "details": [
          "Revitalizing Barrier (Major Perk): healing per second 35 -> 30"
        ],
        "playstyle_impact": "Expect slightly less self-sustain from the bubble, so dive and leave sooner.",
        "meta_impact": "Still a top dive tank, but slipped a tier."
      },
      {
        "character": "Anran",
        "type": "adjustment",
        "details": [
          "Zhuque Fans damage 22 -> 24",
          "Inferno Rush: knockback removed, can no longer hit the same target more than once per use",
          "Vermillion Ascent cast time 1.2s -> 1s"
        ],
        "playstyle_impact": "Do more damage with fans at range and use Inferno Rush to reposition rather than for burst.",
        "meta_impact": "Stays a mid-tier damage option."
      },
      {
        "character": "Echo",
        "type": "buff",
        "details": [
          "Aerial Munitions (Minor Perk): now also refills ammo on use"
        ],
        "playstyle_impact": "Take flight to reload mid-fight and keep up aerial pressure.",
        "meta_impact": "Better in air comps with Pharah, and strong in Grandmaster."
      },
      {
        "character": "Emre",
        "type": "buff",
        "details": [
          "Cyber Frag detonation time 0.6s -> 0.5s"
        ],
        "playstyle_impact": "Frags punish targets faster, so use them more aggressively in close trades.",
        "meta_impact": "Small buff for a hero that remains among the weakest damage picks."
      },
      {
        "character": "Genji",
        "type": "nerf",
        "details": [
          "Deflect duration 2s -> 1.5s"
        ],
        "playstyle_impact": "Time Deflect precisely to key damage instead of holding it up as a long safety window.",
        "meta_impact": "Still a top dive pick, but slightly less dominant."
      },
      {
        "character": "Reaper",
        "type": "buff",
        "details": [
          "Base health 275 -> 300"
        ],
        "playstyle_impact": "Survive longer while flanking and brawling at close range.",
        "meta_impact": "Rose to one of the best damage heroes by win rate and pick rate."
      },
      {
        "character": "Shion",
        "type": "buff",
        "details": [
          "Execution starting spread 8.5 -> 5.7 degrees",
          "Satsuriku Spree cast/move time per volley 0.6s -> 0.5s"
        ],
        "playstyle_impact": "Shots land more reliably without a full charge, so take quicker close-range duels.",
        "meta_impact": "Mid-tier overall, but heavily picked in Grandmaster."
      },
      {
        "character": "Vendetta",
        "type": "nerf",
        "details": [
          "Palatine Fang overhead leap speed 11 -> 9.5",
          "Palatine Fang initial swing delay 0.15s -> 0.2s",
          "Whirlwind Dash (Raging Storm perk) horizontal knockback 8 -> 4"
        ],
        "playstyle_impact": "Combos are slower, so pick engages carefully instead of chaining leaps.",
        "meta_impact": "Toned down but still a strong melee pick for rush comps."
      },
      {
        "character": "Ana",
        "type": "nerf",
        "details": [
          "Biotic Grenade explosion damage 90 -> 60 (healing unchanged)"
        ],
        "playstyle_impact": "Use nade mainly for anti-heal and healing rather than burst damage.",
        "meta_impact": "Still widely picked but has one of the lowest support win rates."
      },
      {
        "character": "Brigitte",
        "type": "buff",
        "details": [
          "Inspire internal cooldown 1.25s -> 1s",
          "Inspire instant healing 12 -> 15"
        ],
        "playstyle_impact": "Hit enemies constantly in brawls to keep Inspire healing flowing.",
        "meta_impact": "Jumped to a top support, the core of brawl and rush comps."
      },
      {
        "character": "Doctrine",
        "type": "nerf",
        "details": [
          "Eternal Scepter primary fire recovery 0.6 -> 0.65",
          "Infused damage 90 -> 80, infused healing 120 -> 110",
          "Shrouded Momentum cooldown 8s -> 10s",
          "Infuse cooldown 8s -> 9s"
        ],
        "playstyle_impact": "Output and escapes are lower, so time Infuse carefully and position more safely.",
        "meta_impact": "Still heavily picked, but now near a 50% win rate after repeated nerfs."
      },
      {
        "character": "Illari",
        "type": "buff",
        "details": [
          "Solar Rifle time to max charge 0.65s -> 0.575s",
          "Healing Pylon heal per projectile 40 -> 50"
        ],
        "playstyle_impact": "Use more charged shots for damage and place Pylon to anchor a hold position.",
        "meta_impact": "Rose sharply to one of the top supports by win rate."
      },
      {
        "character": "Jetpack Cat",
        "type": "nerf",
        "details": [
          "Base health 225 -> 200",
          "Frenetic Flight acceleration 25 -> 28 m/s",
          "Frenetic Flight fuel regeneration 25% -> 20% per second"
        ],
        "playstyle_impact": "Stay further from danger and use the faster acceleration for repositioning, not aggression.",
        "meta_impact": "Most banned support but low win rate, now weaker still."
      },
      {
        "character": "Sombra",
        "type": "nerf",
        "details": [
          "Hotfix duration 12s -> 10s",
          "Cyberspace weaken effect 50% -> 40%",
          "EMP now overrides enemy hack effects on health packs"
        ],
        "playstyle_impact": "Target Hotfix and Weaken more carefully because their windows are shorter and weaker.",
        "meta_impact": "Fell from top tier to a mid-tier support."
      },
      {
        "character": "Wrecking Ball",
        "type": "buff",
        "details": [
          "Grappling Claw: base speed limit while retracting +15% (Nov 5 hotfix)",
          "Grappling Claw: allied speed boosts now also raise the retraction speed limit (Nov 5 hotfix)"
        ],
        "playstyle_impact": "Retract grapple more often to rotate and escape, ideally with Lúcio or Juno speed.",
        "meta_impact": "Small buff for one of the lowest win-rate tanks, and not enough to make him meta."
      }
    ]
  },
