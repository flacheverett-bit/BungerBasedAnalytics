  "game": "deadlock",
  "updated": "2026-11-21T07:44:49Z",
  "latest": {
    "version": "11-04-2026",
    "date": "2026-11-04",
    "title": "Minor Update - 11-04-2026",
    "url": "https://store.steampowered.com/news/app/1422450/view/680766308468391944",
    "summary": "A small balance follow-up to the Oct 30 Halloween update, aimed at the six heroes added in October. Celeste, Deadman Danny and Baba are nerfed, Rat King and Nurse Harrow regain some of their Oct 30 losses, and Apollo and Mo & Krill get targeted buffs. Stacking Healbane now has steeper diminishing returns, and Ranked Season 2 (Nov 5) adds a 4th ban per match.",
    "meta_impact": "Burst and sustain from the October heroes keep getting trimmed. Celeste's ultimate is no longer an automatic teamfight win, and Deadman Danny shifts from dive-and-execute to patient poke. Weaker Healbane stacking quietly helps sustain heroes like Nurse Harrow, Rem and Mo & Krill.\n\nFrontline and dive brawlers come out ahead, led by Mo & Krill and Apollo's new disarming parry. With 4 bans in ranked, expect the October heroes to be banned often and drafts to lean on older, proven carries and brawlers.",
    "changes": [
      {
        "character": "Apollo",
        "type": "buff",
        "details": [
          "Riposte: Pommel Hit now also disarms the target",
          "Riposte: Pommel Hit now ends any parry the target already has active",
          "Riposte: T2 duration bonus increased from +0.6s to +0.7s",
          "Itani Lo Sahn: T3 bonus damage increased from +50% to +60%"
        ],
        "playstyle_impact": "Riposte now works as a hard answer to melee and parry-heavy opponents. A successful counter both disarms the target and cancels their parry, so Apollo can start a melee exchange knowing the enemy can't parry back right away. Players should bait out melee commits and then punish them, and keep levelling Itani Lo Sahn to T3, where the extra burst rewards finishing an engage.",
        "meta_impact": "Apollo gets stronger in brawler-heavy lobbies and against opponents who rely on parrying his melee. He looks better as a backline-diving assassin than he did after his spring nerfs."
      },
      {
        "character": "Celeste",
        "type": "nerf",
        "details": [
          "Dazzling Trick: T3 silence duration reduced from +1.25s to +0.75s",
          "Radiant Daggers: cast range reduced from 30m to 25m (moved to T2)",
          "Radiant Daggers: Spirit Amp per stack reduced from +7% to +6% (moved to T3)",
          "Shining Wonder: movement slow reduced from -32% to -28%",
          "Shining Wonder: cooldown increased from 160s to 170s",
          "Shining Wonder: bounce range reduced from 15.5m to 15m",
          "Shining Wonder: T1 move-speed slow reduced from -16% to -14%",
          "Shining Wonder: T2 bonus damage reduced from +90 to +80"
        ],
        "playstyle_impact": "Celeste has less lockdown, so she can't count on a long silence followed by a guaranteed bouncing ult. Radiant Daggers also has a shorter cast range and less spirit amp per stack. She has to set up kills with her team instead of chaining them herself. Shining Wonder comes up less often and is easier to walk out of, so save it for clumped fights rather than using it on cooldown.",
        "meta_impact": "This is Celeste's latest in a long run of nerfs since August, which pushes her further from must-pick or must-ban status. She now fits as a combo piece next to other crowd control rather than as a standalone teamfight win condition."
      },
      {
        "character": "Deadman Danny",
        "type": "nerf",
        "details": [
          "Close The Deal: bonus damage against targets under half health reduced from +75% to +55%",
          "Strix Salvo: spirit scaling reduced by 8%",
          "Chimera Mk1: T2 heal on hit reduced from 150 to 125",
          "Chimera Mk1: T2 heal spirit scaling reduced from 2.0 to 1.7"
        ],
        "playstyle_impact": "Danny's execute window is weaker, so diving low-health targets with the jetpack and finishing them with Close The Deal is less reliable. The smaller Chimera heal means he can't sustain through a commit as easily. He should poke from range with charged shots and Strix Salvo first and only go in once a target is already low.",
        "meta_impact": "This partly reverses the large Oct 14 buff package (which raised Close The Deal from +50% to +75%) after he overperformed. He remains a viable gun carry with a high skill ceiling but is less of a snowball pick."
      },
      {
        "character": "Mo & Krill",
        "type": "buff",
        "details": [
          "Scorn: healing from heroes increased from 1.2x to 1.3x",
          "Burrow: damage radius increased by 0.5m",
          "Sand Blast: T2 now applies -28% movement slow and -28% dash-distance slow (was -24% / -26%)",
          "Combo: health gained per kill increased from 40 to 50"
        ],
        "playstyle_impact": "Mo & Krill get better at sustained brawling. Scorn heals more off heroes, Burrow catches more targets on the way in, and a stronger Sand Blast slow keeps enemies inside Combo range. Engage with Burrow, follow with Sand Blast, then use Combo on a priority target, and keep Scorn running for sustain through the fight.",
        "meta_impact": "This offsets part of the Oct 30 spirit-scaling cut and leaves them as a steady frontline initiator. They pair well with burst-damage carries who can follow up on a Combo pick."
      },
      {
        "character": "Nurse Harrow",
        "type": "buff",
        "details": [
          "Bullet damage increased by 8%",
          "Lurking Terrors: vertical detection angle increased from 50% to 65%",
          "Lurking Terrors: fear build-up time reduced from 2s to 1.75s"
        ],
        "playstyle_impact": "Part of Nurse's gun damage comes back after the Oct 30 nerf (-10% base), so she can trade in lane again instead of only healing with needles. Lurking Terrors applies fear faster and from steeper angles, so playing from high ground above enemies works again as a way to set up fear.",
        "meta_impact": "This is a partial rollback after a heavy Oct 30 nerf. She remains a sustain-focused support whose healing is weak into Healbane and other anti-heal, but she is now viable again in coordinated lineups."
      },
      {
        "character": "Rat King",
        "type": "buff",
        "details": [
          "Bullet damage increased from 5.7 to 5.8",
          "Ammo increased from 24 to 26",
          "Scrap Grenade: minimum fuse extension when the grenade is meleed reduced from 0.4s to 0.25s",
          "Rule, Ratannia!: bonus move speed increased from +3m to +4m",
          "Rule, Ratannia!: T1 now also reduces cooldown by 25s"
        ],
        "playstyle_impact": "Rule, Ratannia! becomes a usable engage tool again. Taking T1 brings the cooldown down from 180s, and the extra move speed helps Rat King reach the backline. Meleed Scrap Grenades go off sooner, which makes the melee-redirect combo harder to escape.",
        "meta_impact": "This is a modest recovery after Rat King was nerfed hard on Oct 5 and Oct 30. He is a mid-tier brawler for comps that want a flag-based area denial engage."
      },
      {
        "character": "Baba",
        "type": "nerf",
        "details": [
          "Spirit resist scaling reduced from 0.7 to 0.5",
          "Melee damage per boon reduced by 10%",
          "Baba's Brew cooldown increased",
          "Granny Long Legs resist reduced from 30% to 25%"
        ],
        "playstyle_impact": "Baba can no longer face-tank spirit damage while stacking boons, so she has to pick her melee engages more carefully and lean on Baba's Brew timing rather than trading freely in lane.",
        "meta_impact": "Still a strong pick, but the nerfs plus the new 4-ban format make her less of a must-ban; expect her win rate to drift toward the pack as players stop over-investing in melee boons."
      }
    ]
  },
