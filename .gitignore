__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db
.claude/
# Raw third-party exports stay local; the processed data in data/<game>/ is what's published.
*.csv
# ...except the warehouse's own CSV exports, which are published for download.
!data/exports/*.csv
